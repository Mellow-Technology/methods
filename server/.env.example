# Copy to server/.env. Every setting is optional; these are the defaults.

DATABASE_URL=postgres://localhost/methods
BIND_ADDR=127.0.0.1:8080
# The origin people use in the browser (the Next dev server in development).
# OIDC redirect URLs and the MCP URL shown to admins are built from it.
PUBLIC_URL=http://localhost:3000
# COOKIE_SECURE defaults to true when PUBLIC_URL is https.
# COOKIE_SECURE=false
SESSION_DAYS=30

# Email/password login (mostly for testing) and open sign-up.
PASSWORD_LOGIN=true
ALLOW_REGISTRATION=true

# The exported web app (web/out) is served when this directory exists.
# STATIC_DIR=../web/out

# ---- Object storage --------------------------------------------------------
# Without S3_BUCKET, uploads go to local disk.
LOCAL_STORAGE_DIR=./data/files
MAX_UPLOAD_MB=25
# Any S3-compatible service: AWS, MinIO, Garage, SeaweedFS, R2, ...
# S3_BUCKET=methods
# S3_REGION=us-east-1
# S3_ENDPOINT=http://127.0.0.1:8333
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ALLOW_HTTP=true
# S3_VIRTUAL_HOSTED=false

# ---- OpenID Connect --------------------------------------------------------
# Register the redirect URL  ${PUBLIC_URL}/api/auth/oidc/callback  with the provider.
# OIDC_ISSUER=https://auth.example.com/application/o/methods/
# OIDC_CLIENT_ID=methods
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Authentik

RUST_LOG=info,sqlx=warn
